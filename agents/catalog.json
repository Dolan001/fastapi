{
  "version": "2.0.0",
  "format": "markdown-first",
  "path_pattern": "agents/{agent}.md",
  "framework": "fastapi",
  "agents": [
    {
      "agent": "fastapi-solution-architect",
      "purpose": "Design domain, service, repository, schema, and dependency boundaries from requirements and target discovery.",
      "writes_application_code": false,
      "outputs": ["backend architecture decision", "domain map", "task contracts"]
    },
    {
      "agent": "fastapi-backend-implementer",
      "purpose": "Implement requirement-backed FastAPI vertical slices in the target monorepo.",
      "writes_application_code": true,
      "allowed_target_paths": ["apps/backend/**", "docs/api/**", ".ai/test-commands.json", ".ai/evidence/**"],
      "maximum_retries_per_failure": 2
    },
    {
      "agent": "fastapi-independent-verifier",
      "purpose": "Independently verify types, API contracts, persistence, migrations, tests, and security.",
      "writes_application_code": false,
      "allowed_target_paths": [".ai/evidence/**", "artifacts/**"]
    }
  ]
}
