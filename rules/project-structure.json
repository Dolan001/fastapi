{
  "version": "1.3.0",
  "framework": "fastapi",
  "target_root": "apps/backend",
  "required_paths": [
    "pyproject.toml",
    "alembic.ini",
    ".env.example",
    ".gitignore",
    ".dockerignore",
    "Dockerfile",
    "README.md",
    "app/__init__.py",
    "app/main.py",
    "app/api/__init__.py",
    "app/api/dependencies.py",
    "app/api/v1/__init__.py",
    "app/api/v1/router.py",
    "app/api/v1/health.py",
    "app/core/config.py",
    "app/core/errors.py",
    "app/core/logging.py",
    "app/core/middleware.py",
    "app/core/security.py",
    "app/core/__init__.py",
    "app/db/__init__.py",
    "app/db/base.py",
    "app/db/engine.py",
    "app/db/session.py",
    "app/db/health.py",
    "app/db/naming.py",
    "app/db/migrations/__init__.py",
    "app/db/migrations/env.py",
    "app/db/migrations/versions",
    "app/domains/__init__.py",
    "tests/conftest.py",
    "scripts/validate_project.py",
    "scripts/check_database.py",
    "scripts/check_migration_plan.py",
    "scripts/check_query_plans.py",
    "scripts/check_openapi_drift.py"
  ],
  "required_directories": ["app/db/migrations/versions"],
  "required_path_sets": [
    {
      "name": "dependency-lock",
      "alternatives": [
        ["uv.lock"],
        ["poetry.lock"],
        ["pdm.lock"],
        ["requirements.lock", "requirements-dev.lock"]
      ]
    }
  ],
  "conditional_path_groups": [
    {
      "name": "background-tasks",
      "trigger_globs": ["app/worker/celery_app.py", "app/domains/*/tasks.py"],
      "required_paths": [
        "app/worker/__init__.py",
        "app/worker/config.py",
        "app/worker/celery_app.py",
        "scripts/check_workers.py",
        "compose.yaml"
      ],
      "required_directories": [],
      "required_source_patterns": [
        {
          "id": "celery-redis-dependency",
          "globs": ["pyproject.toml"],
          "pattern": "celery\\[redis\\]",
          "ignore_case": true,
          "message": "Background work requires the Celery Redis dependency extra in pyproject.toml."
        },
        {
          "id": "redis-broker-environment",
          "globs": [".env.example"],
          "pattern": "^CELERY_BROKER_URL=redis://",
          "ignore_case": false,
          "message": "The example environment must declare a Redis Celery broker URL."
        },
        {
          "id": "celery-application",
          "globs": ["app/worker/celery_app.py"],
          "pattern": "Celery\\s*\\(",
          "ignore_case": false,
          "message": "app/worker/celery_app.py must create the Celery application."
        },
        {
          "id": "domain-task-discovery",
          "globs": ["app/worker/celery_app.py"],
          "pattern": "(?:include\\s*=|autodiscover_tasks\\s*\\()",
          "ignore_case": false,
          "message": "The FastAPI Celery application must explicitly include or discover domain tasks."
        },
        {
          "id": "fastapi-broker-setting",
          "globs": ["app/worker/config.py"],
          "pattern": "CELERY_BROKER_URL",
          "ignore_case": false,
          "message": "FastAPI worker configuration must bind the validated Celery broker URL."
        },
        {
          "id": "redis-compose-service",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "^\\s*redis:\\s*(?:#.*)?$",
          "ignore_case": false,
          "message": "The backend compose file must define a Redis service."
        },
        {
          "id": "redis-compose-image",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "^\\s*image:\\s*redis(?::|@)",
          "ignore_case": true,
          "message": "The Redis compose service must use an explicitly versioned Redis image."
        },
        {
          "id": "worker-compose-service",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "^\\s*worker:\\s*(?:#.*)?$",
          "ignore_case": false,
          "message": "The backend compose file must define a Celery worker service."
        },
        {
          "id": "worker-compose-command",
          "globs": ["compose.yaml", "compose.yml"],
          "pattern": "celery[^\\n]*\\bworker\\b",
          "ignore_case": true,
          "message": "The worker compose service must start a Celery worker process."
        }
      ]
    },
    {
      "name": "realtime",
      "trigger_globs": ["app/realtime/manager.py", "app/domains/*/websocket.py"],
      "required_paths": ["app/realtime/__init__.py", "app/realtime/config.py", "app/realtime/events.py", "app/realtime/manager.py", "scripts/check_realtime.py", "compose.yaml"],
      "required_directories": [],
      "required_source_patterns": [
        {"id": "websockets-dependency", "globs": ["pyproject.toml"], "pattern": "websockets", "ignore_case": true, "message": "FastAPI realtime requires the WebSockets runtime dependency."},
        {"id": "redis-realtime-dependency", "globs": ["pyproject.toml"], "pattern": "redis(?:\\[hiredis\\])?", "ignore_case": true, "message": "Multi-process FastAPI realtime requires Redis."},
        {"id": "redis-realtime-setting", "globs": ["app/realtime/config.py"], "pattern": "REALTIME_REDIS_URL", "ignore_case": false, "message": "FastAPI realtime configuration must bind the Redis URL."},
        {"id": "redis-realtime-environment", "globs": [".env.example"], "pattern": "^REALTIME_REDIS_URL=redis", "ignore_case": false, "message": "The example environment must declare the realtime Redis URL."},
        {"id": "redis-compose-service-realtime", "globs": ["compose.yaml", "compose.yml"], "pattern": "^\\s*redis:\\s*(?:#.*)?$", "ignore_case": false, "message": "Realtime compose must define Redis."}
      ]
    }
  ],
  "domain_path_pattern": "app/domains/<domain>",
  "module_path_pattern": "app/domains/<module>",
  "module_naming": {
    "style": "snake_case",
    "ambiguous_names": ["identity", "work", "operations", "data", "management", "collaboration"],
    "familiar_fallback_names": ["accounts", "authentication", "users", "notifications", "articles", "blog", "posts", "tasks", "todos", "webhooks", "chat", "files", "attachments", "payments", "orders", "products", "reports"],
    "responsibility_packages": [
      {"path": "schemas", "trigger_paths": ["schemas"], "minimum_modules": 1, "forbidden_module_names": ["commands.py", "views.py", "input.py", "output.py", "schemas.py"], "extensions": [".py"]},
      {"path": "routes", "trigger_paths": ["routes", "dependencies.py", "schemas"], "minimum_modules": 1, "forbidden_module_names": ["routes.py"], "extensions": [".py"]}
    ],
    "max_lines": [
      {"globs": ["models.py", "service.py", "repository.py", "queries.py", "dependencies.py", "tasks.py", "websocket.py", "schemas/*.py", "routes/*.py"], "maximum": 300}
    ]
  },
  "required_domain_paths": [
    "__init__.py",
    "models.py",
    "service.py",
    "tests/test_service.py"
  ],
  "required_domain_directories": ["tests"],
  "conditional_domain_groups": [
    {
      "name": "persistence",
      "trigger_paths": ["repository.py"],
      "required_paths": ["repository.py", "tests/test_repository.py"],
      "required_directories": []
    },
    {
      "name": "optimized-reads",
      "trigger_paths": ["queries.py"],
      "required_paths": ["queries.py", "tests/test_queries.py"],
      "required_directories": []
    },
    {
      "name": "json-api",
      "trigger_paths": ["routes", "dependencies.py", "schemas"],
      "required_paths": [
        "schemas",
        "schemas/__init__.py",
        "routes",
        "routes/__init__.py",
        "dependencies.py",
        "tests/test_schemas.py",
        "tests/test_api.py"
      ],
      "required_directories": ["schemas", "routes"]
    },
    {
      "name": "background-tasks",
      "trigger_paths": ["tasks.py"],
      "required_paths": ["tasks.py", "outbox.py", "tests/test_tasks.py", "tests/test_outbox.py"],
      "required_directories": []
    },
    {
      "name": "realtime",
      "trigger_paths": ["websocket.py"],
      "required_paths": [
        "websocket.py",
        "events.py",
        "tests/test_realtime.py",
        "tests/test_realtime_auth.py"
      ],
      "required_directories": []
    }
  ],
  "minimum_domain_instances": 1,
  "domain_excluded_paths": [],
  "source_rules": [
    {
      "id": "no-sqlite-runtime",
      "globs": ["app/**/*.py", "alembic.ini"],
      "pattern": "sqlite(?:\\+[a-z0-9_]+)?://|aiosqlite|\\.sqlite3?\\b",
      "ignore_case": true,
      "scan_strings": true,
      "message": "FastAPI runtime and migrations must use PostgreSQL without a SQLite fallback."
    },
    {
      "id": "main-does-not-own-domain-behavior",
      "globs": ["app/main.py"],
      "pattern": "(?:from\\s+app\\.domains|import\\s+app\\.domains|\\b(?:db|session)\\.(?:add|delete|execute|commit|rollback)\\s*\\()",
      "ignore_case": false,
      "message": "FastAPI main.py assembles infrastructure and version routers only."
    },
    {
      "id": "no-runtime-create-all",
      "globs": ["app/**/*.py"],
      "pattern": "metadata\\.create_all\\s*\\(",
      "ignore_case": false,
      "message": "Application startup must not create tables; Alembic owns schema creation."
    },
    {
      "id": "routes-do-not-persist",
      "globs": ["app/domains/*/routes/*.py"],
      "pattern": "\\b(?:db|session)\\.(?:add|add_all|delete|execute|scalar|scalars|flush|commit|rollback)\\s*\\(",
      "ignore_case": false,
      "message": "FastAPI routes translate HTTP and must delegate persistence."
    },
    {
      "id": "repositories-do-not-commit",
      "globs": ["app/domains/*/repository.py"],
      "pattern": "\\b(?:db|session|self\\.session|self\\._session)\\.(?:commit|rollback)\\s*\\(",
      "ignore_case": false,
      "message": "FastAPI repositories never commit or roll back service-owned transactions."
    },
    {
      "id": "schemas-do-not-access-database",
      "globs": ["app/domains/*/schemas/*.py"],
      "pattern": "(?:from\\s+sqlalchemy|import\\s+sqlalchemy|\\bAsyncSession\\b|\\bSession\\b)",
      "ignore_case": false,
      "message": "Pydantic transport schemas must not import or access database sessions."
    }
  ]
}
