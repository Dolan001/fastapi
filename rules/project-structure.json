{
  "version": "1.0.0",
  "framework": "fastapi",
  "target_root": "apps/backend",
  "required_paths": [
    "pyproject.toml",
    "requirements.lock",
    "requirements-dev.lock",
    "alembic.ini",
    ".env.example",
    "Dockerfile",
    "README.md",
    "app/main.py",
    "app/api/dependencies.py",
    "app/api/v1/router.py",
    "app/api/v1/health.py",
    "app/core/config.py",
    "app/core/errors.py",
    "app/core/logging.py",
    "app/core/middleware.py",
    "app/core/security.py",
    "app/db/base.py",
    "app/db/engine.py",
    "app/db/session.py",
    "app/db/health.py",
    "app/db/naming.py",
    "app/db/migrations/env.py",
    "tests/conftest.py",
    "scripts/validate_project.py",
    "scripts/check_database.py",
    "scripts/check_migration_plan.py",
    "scripts/check_query_plans.py",
    "scripts/check_openapi_drift.py"
  ],
  "required_directories": [],
  "domain_path_pattern": "app/domains/<domain>",
  "required_domain_paths": [
    "models.py",
    "schemas/__init__.py",
    "schemas/commands.py",
    "schemas/views.py",
    "repository.py",
    "queries.py",
    "service.py",
    "routes.py",
    "dependencies.py",
    "tests/test_service.py",
    "tests/test_repository.py",
    "tests/test_queries.py",
    "tests/test_schemas.py",
    "tests/test_api.py"
  ],
  "required_domain_directories": ["schemas", "tests"],
  "minimum_domain_instances": 1,
  "domain_excluded_paths": [],
  "forbidden_patterns": [
    "domain behavior in app/main.py",
    "direct persistence in routes.py",
    "commit inside repository.py or routes.py",
    "database access from schemas/**",
    "unbounded or client-controlled ordering",
    "SQLite fallback in generated configuration",
    "metadata create_all in application startup",
    "untyped production configuration",
    "destructive migration without approval",
    "real secrets in environment files"
  ]
}
